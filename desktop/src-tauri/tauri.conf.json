{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StoryAlter",
  "version": "2.1.1",
  "identifier": "com.storyalter.desktop",
  "build": {
    "frontendDist": "../../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "StoryAlter · AI 故事工作室",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../bin": "engine/bin",
      "../../src": "engine/src",
      "../../ui": "engine/ui",
      "../../package.json": "engine/package.json",
      "../../mcp.json": "engine/mcp.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
